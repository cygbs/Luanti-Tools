diff --git a/src/network/ws_proxy.cpp b/src/network/ws_proxy.cpp
new file mode 100644
index 0000000..e46ca5f
--- /dev/null
+++ b/src/network/ws_proxy.cpp
@@ -0,0 +1,310 @@
+// Luanti WebSocket Proxy — embedded WS→MTP bridge for browser (minetest-wasm) clients.
+// Based on minetest-wasm-proxy-cpp, adapted to run inside Luanti's process.
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "ws_proxy.h"
+#include "App.h"
+#include "network/address.h"
+#include <libusockets.h>
+
+#include "log.h"
+
+#include <string>
+#include <string_view>
+#include <regex>
+#include <cstring>
+#include <vector>
+
+/* ── Per-socket session data ──────────────────────────────────── */
+
+enum class WsState { HANDSHAKE, RELAY, DNS, SINK, DEAD };
+
+struct WsSession {
+	WsState state = WsState::HANDSHAKE;
+	std::string real_ip;
+};
+
+/* ── Globals ──────────────────────────────────────────────────── */
+
+static int g_ws_port = 0;
+static std::string g_ws_bind;
+static std::string g_dns_ip = "1.1.1.1";
+static WsProxy *g_proxy = nullptr;
+
+// Outgoing queue: MTP send thread pushes, µWS timer drains.
+struct OutgoingPacket {
+	uWS::WebSocket<false, true, WsSession> *ws;
+	std::string data;
+};
+static std::mutex g_outgoing_mutex;
+static std::vector<OutgoingPacket> g_outgoing;
+
+/* ── PROXY protocol handler ───────────────────────────────────── */
+
+static void handle_handshake(
+	uWS::WebSocket<false, true, WsSession> *ws,
+	const std::string &text)
+{
+	auto *sess = ws->getUserData();
+
+	std::regex proxy_re(
+		R"(PROXY\s+IPV[46]\s+(UDP|TCP)\s+(\S+)\s+(\d+))",
+		std::regex::icase);
+	std::smatch m;
+	if (!std::regex_search(text, m, proxy_re)) {
+		ws->send("UNSUPPORTED", uWS::OpCode::TEXT);
+		return;
+	}
+
+	std::string proto = m[1].str();
+	for (auto &c : proto) c = (char)toupper((unsigned char)c);
+	std::string client_ip = m[2].str();
+	int client_port = std::stoi(m[3].str());
+
+	if (proto == "UDP") {
+		infostream << "WS: UDP inject " << sess->real_ip
+		           << " (client asked " << client_ip
+		           << ":" << client_port << ")" << std::endl;
+
+		sess->state = WsState::RELAY;
+		ws->send("PROXY OK", uWS::OpCode::TEXT);
+		return;
+	}
+
+	if (proto == "TCP" && client_ip == "10.0.0.1" && client_port == 53) {
+		sess->state = WsState::DNS;
+		ws->send("PROXY OK", uWS::OpCode::TEXT);
+		return;
+	}
+
+	if (proto == "TCP") {
+		sess->state = WsState::SINK;
+		ws->send("PROXY OK", uWS::OpCode::TEXT);
+		return;
+	}
+}
+
+/* ── Outgoing drain timer ─────────────────────────────────────── */
+
+static void drain_outgoing(us_timer_t *) {
+	std::lock_guard<std::mutex> lk(g_outgoing_mutex);
+	for (auto &p : g_outgoing) {
+		p.ws->send(std::string_view(p.data),
+		           uWS::OpCode::BINARY);
+	}
+	g_outgoing.clear();
+}
+
+/* ── Event loop thread function ───────────────────────────────── */
+
+static void ws_thread_func() {
+	auto app = uWS::App()
+	.ws<WsSession>("/*", {
+		.compression = uWS::SHARED_COMPRESSOR,
+		.maxPayloadLength = 64 * 1024 * 1024,
+		.idleTimeout = 0,
+		.maxBackpressure = 64 * 1024 * 1024,
+		.closeOnBackpressureLimit = false,
+		.resetIdleTimeoutOnSend = false,
+		.sendPingsAutomatically = false,
+
+		/* ── upgrade: capture real IP from X-Forwarded-For ──── */
+		.upgrade = [](auto *res, auto *req, auto *context) {
+			std::string real_ip;
+			auto xff = req->getHeader("x-forwarded-for");
+			if (!xff.empty()) {
+				auto comma = xff.find(',');
+				real_ip = (comma != std::string_view::npos)
+					? std::string(xff.substr(0, comma))
+					: std::string(xff);
+				auto start = real_ip.find_first_not_of(" \t");
+				if (start == std::string::npos) start = 0;
+				real_ip = real_ip.substr(start);
+			}
+
+			WsSession sd;
+			sd.real_ip = real_ip;
+
+			res->template upgrade<WsSession>(
+				std::move(sd),
+				req->getHeader("sec-websocket-key"),
+				req->getHeader("sec-websocket-protocol"),
+				req->getHeader("sec-websocket-extensions"),
+				context);
+		},
+
+		/* ── open ──────────────────────────────────────────── */
+		.open = [](auto *ws) {
+			auto *sess = ws->getUserData();
+			sess->state = WsState::HANDSHAKE;
+			if (sess->real_ip.empty())
+				sess->real_ip = std::string(
+					ws->getRemoteAddressAsText());
+			if (g_proxy)
+				g_proxy->onWsOpen(sess->real_ip, ws);
+			infostream << "WS: [" << sess->real_ip
+			           << "] connected" << std::endl;
+		},
+
+		/* ── message ───────────────────────────────────────── */
+		.message = [](auto *ws, std::string_view message,
+		              uWS::OpCode opCode) {
+			auto *sess = ws->getUserData();
+			if (sess->state == WsState::DEAD) return;
+
+			if (sess->state == WsState::HANDSHAKE) {
+				if (opCode != uWS::OpCode::TEXT) {
+					ws->close();
+					return;
+				}
+				handle_handshake(ws, std::string(message));
+				return;
+			}
+
+			if (sess->state == WsState::RELAY) {
+				if (g_proxy)
+					g_proxy->injectPacket(message, sess->real_ip);
+				return;
+			}
+
+			if (sess->state == WsState::DNS) {
+				std::string hostname(message);
+				if (!hostname.empty() && hostname.back() == '\0')
+					hostname.pop_back();
+				verbosestream << "WS: [" << sess->real_ip
+				              << "] DNS: "
+				              << (hostname.empty() ? "(empty)" : hostname)
+				              << " -> " << g_dns_ip << std::endl;
+
+				unsigned int a = 0, b = 0, c = 0, d = 0;
+				char ip_buf[4];
+				if (sscanf(g_dns_ip.c_str(), "%u.%u.%u.%u",
+				           &a, &b, &c, &d) == 4) {
+					ip_buf[0] = (char)a;
+					ip_buf[1] = (char)b;
+					ip_buf[2] = (char)c;
+					ip_buf[3] = (char)d;
+					ws->send(std::string_view(ip_buf, 4),
+					         uWS::OpCode::BINARY);
+				}
+				return;
+			}
+		},
+
+		/* ── close ─────────────────────────────────────────── */
+		.close = [](auto *ws, int, std::string_view) {
+			auto *sess = ws->getUserData();
+			if (g_proxy)
+				g_proxy->onWsClose(sess->real_ip);
+			infostream << "WS: [" << sess->real_ip
+			           << "] disconnected" << std::endl;
+			sess->state = WsState::DEAD;
+		}
+	});
+
+	/* ── Listen ───────────────────────────────────────────── */
+	std::string listen_addr = g_ws_bind.empty()
+		? "0.0.0.0" : g_ws_bind;
+
+	app.listen(listen_addr, g_ws_port, [](auto *ls) {
+		if (ls) {
+			actionstream << "WebSocket proxy listening on "
+			             << (g_ws_bind.empty() ? "0.0.0.0" : g_ws_bind)
+			             << ":" << g_ws_port << std::endl;
+		} else {
+			errorstream << "WS: Failed to listen on "
+			            << (g_ws_bind.empty() ? "0.0.0.0" : g_ws_bind)
+			            << ":" << g_ws_port << std::endl;
+		}
+	});
+
+	/* ── Outgoing drain timer ─────────────────────────────── */
+	auto *loop = app.getLoop();
+	auto *us_loop = reinterpret_cast<struct us_loop_t *>(loop);
+	struct us_timer_t *out_timer =
+		us_create_timer(us_loop, 1, 0);
+	us_timer_set(out_timer, drain_outgoing, 1, 1);
+
+	app.run();
+}
+
+/* ── WsProxy class methods ────────────────────────────────────── */
+
+WsProxy::~WsProxy() {
+	stop();
+}
+
+bool WsProxy::start(int port, const std::string &bind_addr,
+                     const std::string &dns_ip)
+{
+	if (port <= 0 || port > 65535)
+		return false;
+
+	g_ws_port = port;
+	g_ws_bind = bind_addr;
+	g_dns_ip = dns_ip;
+	g_proxy = this;
+
+	m_running = true;
+	m_thread = std::thread(ws_thread_func);
+	return true;
+}
+
+void WsProxy::stop() {
+	if (!m_running.exchange(false))
+		return;
+	if (m_thread.joinable())
+		m_thread.detach();
+}
+
+void WsProxy::injectPacket(std::string_view data, const std::string &real_ip) {
+	std::lock_guard<std::mutex> lk(m_queue_mutex);
+	m_packet_queue.emplace(std::string(data), real_ip);
+}
+
+bool WsProxy::tryPopPacket(std::string &out_data, std::string &out_real_ip) {
+	std::lock_guard<std::mutex> lk(m_queue_mutex);
+	if (m_packet_queue.empty())
+		return false;
+	auto &front = m_packet_queue.front();
+	out_data = std::move(front.first);
+	out_real_ip = std::move(front.second);
+	m_packet_queue.pop();
+	return true;
+}
+
+void WsProxy::onWsOpen(const std::string &real_ip, void *ws) {
+	std::lock_guard<std::mutex> lk(m_ws_mutex);
+	m_ws_by_ip[real_ip] = ws;
+}
+
+void WsProxy::onWsClose(const std::string &real_ip) {
+	std::lock_guard<std::mutex> lk(m_ws_mutex);
+	m_ws_by_ip.erase(real_ip);
+}
+
+bool WsProxy::trySendWs(const Address &addr, const void *data, int size) {
+	std::string ip = addr.serializeString();
+	// Strip IPv4-mapped IPv6 prefix only when the remainder
+	// is a plain IPv4 address (::ffff:1.2.3.4 → 1.2.3.4).
+	// Real IPv6 addresses like ::1 or 2001:db8::1 are left alone.
+	const char *pfx = "::ffff:";
+	if (ip.compare(0, 7, pfx) == 0 && ip.find(':', 7) == std::string::npos)
+		ip.erase(0, 7);
+
+	std::lock_guard<std::mutex> lk(m_ws_mutex);
+	auto it = m_ws_by_ip.find(ip);
+	if (it == m_ws_by_ip.end())
+		return false;
+
+	// Queue for the µWS event loop to drain (ws->send() is NOT
+	// thread-safe — must be called from the µWS thread).
+	auto *ws = static_cast<uWS::WebSocket<false, true, WsSession> *>(
+		it->second);
+	{
+		std::lock_guard<std::mutex> lk2(g_outgoing_mutex);
+		g_outgoing.push_back({ws, std::string((const char *)data,
+		                                      (size_t)size)});
+	}
+	return true;
+}
